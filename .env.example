# JupyterLab access token (used to log in to http://localhost:8888)
JUPYTER_TOKEN=openclaw

# Pin a specific OpenClaw CLI version for the image build, or leave as "latest".
# The build-time discord plugin sync hook keeps @openclaw/discord aligned with
# whichever version ends up installed in the image, so version-mismatch crashes
# on first Discord use are avoided on slow/ARM rebuilds (e.g. Raspberry Pi).
OPENCLAW_VERSION=latest

# Unify the OpenClaw agent workspace with JupyterLab's working directory.
# Default points at /home/jovyan/work (bind-mounted from ./work on the host),
# so files created by the agent are immediately visible in JupyterLab and
# vice versa. Override only if you also change the bind mount in docker-compose.yml.
OPENCLAW_WORKSPACE=/home/jovyan/work

# Provider credentials forwarded into the container as environment variables.
# OpenClaw's core picks up OPENAI_API_KEY; the discord plugin picks up DISCORD_BOT_TOKEN.
OPENAI_API_KEY=
DISCORD_BOT_TOKEN=

# Discord channel allow-list (applied to openclaw.json at every container start).
#   DISCORD_GUILD_ID      = the Discord server (guild) ID the bot is in.
#   DISCORD_CHANNEL_IDS   = comma-separated channel IDs in that guild the bot
#                           is allowed to read/reply in.
#   DISCORD_REQUIRE_MENTION = if "true", the bot only replies when @-mentioned.
# When both DISCORD_GUILD_ID and DISCORD_CHANNEL_IDS are set, the container
# patches openclaw.json so that channels.discord.guilds.<GUILD>.channels.* is
# replaced atomically with the listed channels.
# IMPORTANT: an initial `openclaw configure` must have been run at least once
# (so openclaw.json exists) for these env vars to take effect.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
DISCORD_REQUIRE_MENTION=false
